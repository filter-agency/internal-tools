# ECS services for staging. Every CFN_PARAM_<Name> becomes parameter <Name> on services.yml.
CFN_PARAM_WebCount="1"
CFN_PARAM_WorkerCount="1"
# Scheduler off until we decide what staging may talk to (Asana, Breathe, Slack, email). Then 1.
CFN_PARAM_SchedulerCount="0"
CFN_PARAM_WebMemory="512"
CFN_PARAM_WorkerMemory="384"
CFN_PARAM_SchedulerMemory="256"
CFN_PARAM_OneOffMemory="384"
