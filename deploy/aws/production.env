# ECS services for production. Every CFN_PARAM_<Name> becomes parameter <Name> on services.yml.
CFN_PARAM_WebCount="1"
# Workers and scheduler stay off until cutover (the droplet is still live). Then 2 and 1.
CFN_PARAM_WorkerCount="0"
CFN_PARAM_SchedulerCount="0"
CFN_PARAM_WebMemory="768"
CFN_PARAM_WorkerMemory="384"
CFN_PARAM_SchedulerMemory="256"
CFN_PARAM_OneOffMemory="512"
